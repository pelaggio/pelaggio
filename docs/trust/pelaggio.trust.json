{
  "schema_version": "0.1.0",
  "product": "pelaggio",
  "release": "0.0.0-unreleased",
  "posture": "intent",
  "generated_from": "trust-claims.yml",
  "threat_model_ref": "./threat-model.md",
  "defaults": {
    "ship_target": "pull-request",
    "telemetry": "off",
    "control_plane_auth": "required_or_loopback_only"
  },
  "capabilities": [
    {
      "id": "repo.write.worktree",
      "description": "Create/edit files while working an item.",
      "default": "allowed",
      "scope": "item_worktree_only",
      "approval": "not_required",
      "evidence": ["TC-011", "TC-015"]
    },
    {
      "id": "shell.exec.worktree",
      "description": "Run shell commands while working an item. The high-trust capability; scoped to the worktree and bounded by budget/turn caps.",
      "default": "allowed",
      "scope": "item_worktree_only",
      "approval": "not_required",
      "evidence": ["TC-011", "TC-015"]
    },
    {
      "id": "pr.open",
      "description": "Open a pull request with the item's work.",
      "default": "allowed",
      "approval": "not_required",
      "evidence": ["TC-003"]
    },
    {
      "id": "git.push.default_branch",
      "description": "Push directly to the repo's default branch.",
      "default": "denied",
      "approval": "explicit_config_required",
      "evidence": ["TC-012"]
    },
    {
      "id": "pr.automerge",
      "description": "Auto-merge a PR once checks pass.",
      "default": "denied",
      "approval": "explicit_config_required",
      "evidence": ["TC-013"]
    },
    {
      "id": "control_plane.spawn_run",
      "description": "Spawn an orchestrator run via the control-plane API.",
      "default": "denied",
      "scope": "authenticated_or_loopback_only",
      "approval": "explicit_config_required",
      "evidence": ["TC-010"]
    }
  ],
  "egress": [
    {
      "destination": "anthropic",
      "data_categories": ["prompts", "repo_paths", "source_context", "diffs", "issue_text"],
      "required": true,
      "retention": "governed by the provider's policy",
      "opt_out": "configure a different model provider",
      "role": "sub_processor"
    },
    {
      "destination": "github",
      "data_categories": ["issues", "pull_requests", "plan_bodies", "diffs", "comments"],
      "required": false,
      "retention": "your GitHub",
      "opt_out": "use a different roadmap adapter",
      "role": "user_controlled_endpoint"
    },
    {
      "destination": "linear",
      "data_categories": ["issues", "comments", "state"],
      "required": false,
      "retention": "your Linear workspace",
      "opt_out": "use a different roadmap adapter",
      "role": "user_controlled_endpoint"
    },
    {
      "destination": "git_remote",
      "data_categories": ["commits", "branches"],
      "required": false,
      "retention": "your remote",
      "opt_out": "n/a — your own remote",
      "role": "user_controlled_endpoint"
    },
    {
      "destination": "notify_webhook",
      "data_categories": ["outcome_metadata"],
      "required": false,
      "retention": "your endpoint",
      "opt_out": "leave notify.url unset (default)",
      "role": "user_controlled_endpoint"
    }
  ],
  "never": [
    "push to your default branch by default",
    "send telemetry or analytics",
    "read known secret files (.env, credentials) without explicit configuration",
    "run install scripts from our published package",
    "merge a pull request the review gate did not pass (in pull-request mode)"
  ],
  "provenance": {
    "npm_provenance": true,
    "signed_tag": true,
    "sigstore_bundle": "planned"
  },
  "claims_ref": "./claims.json"
}
