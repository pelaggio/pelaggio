---
import { sitePath } from "../lib/path.js";
import CopyCommand from "../components/CopyCommand.astro";
import Mark from "../components/Mark.astro";
import Base from "../layouts/Base.astro";
import Workflow from "../components/Workflow.astro";
import { FIT_PROMPT, INIT_COMMAND, REPO_URL, RUN_COMMAND, TAGLINE } from "../lib/copy.js";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import type { createExample } from "../../scripts/example.js";

const example: ReturnType<typeof createExample> = JSON.parse(readFileSync(resolve("public/example/view.json"), "utf8"));

function compact(n: number) {
	if (n < 1000) return String(n);
	const k = n / 1000;
	return `${k >= 10 ? k.toFixed(0) : k.toFixed(1).replace(/\.0$/, "")}k`;
}
---
<Base>
	<a class="skip-link" href="#main">Skip to content</a>
	<div class="onshore">
		<header class="site-header wrap">
			<a class="wordmark" href={sitePath("/")} aria-label="Pelaggio home"><Mark class="mark-lg" />Pelaggio</a>
			<nav aria-label="Main">
				<a href="#example">An example</a>
				<a href={sitePath("/limitations")}>Limitations</a>
				<a href="#install">Get started</a>
				<a href={REPO_URL}>GitHub ↗</a>
			</nav>
		</header>
		<section id="main" class="hero wrap">
			<p class="eyebrow">Your process, across pull requests.</p>
			<h1>{TAGLINE}</h1>
			<p class="hero-copy">You shouldn’t have to coordinate every step of every change. Put your working instructions, review criteria, and checks in the repository. Pelaggio runs that process with your coding agents, from charter to pull request.</p>
			<div class="actions">
				<a class="button primary" href="#install">Try one work item <span aria-hidden="true">↗</span></a>
				<a class="text-link" href="#example">See what comes back <span aria-hidden="true">↓</span></a>
			</div>
			<p class="hero-note">An open-source CLI. Bring the agents you already use.<br /><a href={sitePath("/limitations")}>Read the current limits before your first run.</a></p>
		</section>
	</div>

	<div class="waterline" aria-hidden="true">
		<div class="waterline-cast">
			<img src={sitePath("/joe-watch.png")} width="1221" height="1199" alt="" class="joe-watch" />
		</div>
	</div>

	<div class="onshore">
		<section class="working wrap" aria-labelledby="working-title">
			<div>
				<p class="eyebrow">How it works</p>
				<h2 id="working-title">Write down how you work.</h2>
			</div>
			<div class="working-copy">
				<p>Put the project’s conventions in its agent instructions, what you look for in its review rubric, and how to verify a change in its check commands. Those shared files guide the next work item too.</p>
				<p>For each item, define the outcome and boundaries. Pelaggio runs implementation and review in a git worktree, with planning when the item calls for it. Shipping opens a pull request by default; your configuration controls delivery.</p>
				<p>Start with a change you can judge yourself. Tests cover what they exercise. Review can miss things.</p>
				<a class="text-link" href={sitePath("/limitations")}>Read the operating limits ↗</a>
			</div>
			<div class="workflow-span"><Workflow /></div>
		</section>
	</div>

	<section class="example-section" id="example" aria-labelledby="example-title">
		<div class="wrap">
			<div class="example-intro">
				<div>
					<p class="eyebrow">Examples</p>
					<h2 id="example-title">Two work items.</h2>
				</div>
			</div>
			<fieldset class="scenario-switch">
				<legend>Choose a work item</legend>
				{example.scenarios.map((scenario) => (
					<label>
						<input type="radio" name="scenario" value={scenario.id} checked={scenario.id === "csv"} />
						{scenario.label}
					</label>
				))}
			</fieldset>
			{example.scenarios.map((scenario) => {
				const totalCost = scenario.run.steps.reduce((sum, step) => sum + step.cost, 0);
				const totalIn = scenario.run.steps.reduce((sum, step) => sum + step.tokensIn, 0);
				const totalOut = scenario.run.steps.reduce((sum, step) => sum + step.tokensOut, 0);
				const totalTurns = scenario.run.steps.reduce((sum, step) => sum + step.turns, 0);
				return (
					<article data-scenario={scenario.id} aria-label={scenario.label}>
						<h3 class="scenario-title">{scenario.label}</h3>
						<div class="work-sheet">
							<div class="request">
								<span class="index-label">01 / Request</span>
								<p>“{scenario.request}”</p>
							</div>
							<div class="change">
								<span class="index-label">02 / Decisions</span>
								<ul class="decision-list">
									{scenario.forks.map((fork) => <li>{fork.taken}</li>)}
								</ul>
							</div>
							<div class="checks">
								<span class="index-label">03 / Checks</span>
								{scenario.evaluation ? (
									<ul>
										{scenario.evaluation.cases.map((check) => (
											<li>
												<span class="case-name">{check.name.replace(/^AC-\d+: /, "")}</span>
												<span class:list={["check-result", { "check-skipped": check.result !== "pass" }]}>{check.result}</span>
											</li>
										))}
									</ul>
								) : (
									<p>Independent checks of an implemented candidate have not been captured yet.</p>
								)}
							</div>
							<div class="decision">
								<span class="index-label">04 / Handoff</span>
								<blockquote class="joe-line">
									<span class="say">Joe</span>
									{scenario.joe}
								</blockquote>
								<img src={sitePath("/joe-handoff.png")} width="1221" height="1199" alt="Joe, back from offshore with the catch" class="joe-handoff" />
							</div>
						</div>
						<div class="receipts">
							<fieldset class="receipt-tabs">
								<legend>Receipts</legend>
								<label><input type="radio" name={`receipt-${scenario.id}`} value="charter" checked />Charter</label>
								<label><input type="radio" name={`receipt-${scenario.id}`} value="decisions" />Decisions</label>
								<label><input type="radio" name={`receipt-${scenario.id}`} value="run" />Run</label>
							</fieldset>
							<div class="receipt-panel" data-receipt="charter">
								<dl class="charter-dl">
									<div><dt>Request</dt><dd>“{scenario.request}”</dd></div>
									<div>
										<dt>Accept</dt>
										<dd><ul>{scenario.acceptance.map((line) => <li>{line}</li>)}</ul></dd>
									</div>
									<div><dt>Bounds</dt><dd>{scenario.bounds}</dd></div>
								</dl>
							</div>
							<div class="receipt-panel" data-receipt="decisions">
								<ul class="forks">
									{scenario.forks.map((fork) => (
										<li>
											<strong>{fork.fork}</strong>
											<div class="fork-pair">
												<p><span>Taken</span>{fork.taken}</p>
												<p class="not-taken"><span>Not</span>{fork.notTaken}</p>
											</div>
										</li>
									))}
								</ul>
							</div>
							<div class="receipt-panel" data-receipt="run">
								<p class="run-evidence"><strong>Illustrative run meter.</strong> {scenario.runEvidence}</p>
								<p><a href={sitePath(`/example/${scenario.id}/attempts.json`)}>Captured attempts</a> · <a href={sitePath("/example/receipt.json")}>Capture manifest and digests</a></p>
								<dl class="snapshot-metrics">
									<div><dt>Wall clock</dt><dd>{scenario.run.elapsed}</dd></div>
									<div><dt>Cost</dt><dd>~${totalCost.toFixed(2)}<span class="metric-sub">estimated</span></dd></div>
									<div><dt>Tokens</dt><dd>{compact(totalIn)}<span class="metric-sub"> in · {compact(totalOut)} out</span></dd></div>
									<div><dt>Turns</dt><dd>{totalTurns}</dd></div>
								</dl>
								<table class="step-meter">
									<caption>Illustrative completed path · {scenario.run.attempts} example attempts</caption>
									<thead>
										<tr><th>Step</th><th>Provider</th><th>Model</th><th>Cost</th><th>Turns</th><th>Tokens</th></tr>
									</thead>
									<tbody>
										{scenario.run.steps.map((step) => (
											<tr>
												<th scope="row">{step.name}</th>
												<td>{step.provider}</td>
												<td>{step.model}</td>
												<td>~${step.cost.toFixed(2)}</td>
												<td>{step.turns}</td>
												<td>{compact(step.tokensIn)} / {compact(step.tokensOut)}</td>
											</tr>
										))}
									</tbody>
								</table>
								<ul class="snapshot-constraints">
									{scenario.run.constraints.map((line) => <li>{line}</li>)}
								</ul>
							</div>
						</div>
					</article>
				);
			})}
		</div>
	</section>

	<div class="onshore">
		<section id="install" class="install wrap" aria-labelledby="install-title">
			<div class="install-intro">
				<p class="eyebrow">Try it locally</p>
				<h2 id="install-title">Set up your repository.</h2>
				<p>You’ll need Node 20.6+, git, an authenticated agent CLI, and <code>gh</code> for GitHub pull requests. Provider setup varies; <a href={`${REPO_URL}#quickstart`}>check the setup guide</a> first.</p>
				<p><a href={sitePath("/limitations#before-a-run")}>Before you run it ↗</a></p>
			</div>
			<ol class="install-steps">
				<li><h3>Generate the configuration</h3><p>Generate the skills, quality rubric, sample roadmap, and configuration.</p><CopyCommand command={INIT_COMMAND} /></li>
				<li><h3>Adapt it to your project</h3><p>Give this prompt to your agent. Read the resulting diff before continuing.</p><CopyCommand command={FIT_PROMPT} wrap label="Copy the setup prompt" /></li>
				<li><h3>Run one work item</h3><p>Stay nearby for the first cycle. Follow the work and inspect what comes back.</p><CopyCommand command={RUN_COMMAND} /></li>
			</ol>
		</section>
		<footer class="site-footer wrap">
			<div>
				<a class="wordmark" href={sitePath("/")}><Mark class="mark-sm" />Pelaggio</a>
				<p>© 2026 Chris Horne</p>
			</div>
			<nav aria-label="Footer">
				<a href={sitePath("/limitations")}>Limitations</a>
				<a href={`${REPO_URL}/blob/main/LICENSE`}>AGPL-3.0-or-later</a>
				<a href={REPO_URL}>Source ↗</a>
			</nav>
		</footer>
	</div>
</Base>
