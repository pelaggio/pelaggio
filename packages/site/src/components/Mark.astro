---
interface Props {
	class?: string;
	title?: string;
	decorative?: boolean;
}

const { class: className, title = "Pelaggio", decorative = false } = Astro.props;
import { sitePath } from "../lib/path.js";
---

<img
	src={sitePath("/mark.png")}
	width="512"
	height="361"
	alt={decorative ? "" : title}
	draggable="false"
	class:list={["mark", className]}
	aria-hidden={decorative ? "true" : undefined}
/>
