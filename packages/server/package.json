{
	"name": "@pelaggio/server",
	"version": "0.0.0",
	"private": true,
	"description": "Control-plane daemon for pelaggio — supervises pipeline subprocesses over HTTP.",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"exports": {
		"./types": {
			"types": "./src/types.ts",
			"default": "./src/types.ts"
		}
	},
	"scripts": {
		"dev": "tsx watch scripts/server.ts",
		"start": "tsx scripts/server.ts",
		"typecheck": "pnpm -w exec tsc --noEmit --pretty false -p packages/server",
		"build": "pnpm run typecheck && tsx -e \"import('./src/app.ts')\"",
		"test": "tsx --test --test-timeout=60000 __tests__/*.test.ts"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"hono": "^4.13.5",
		"pelaggio": "workspace:*",
		"ulid": "^3.0.2",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"tsx": "^4.23.12"
	}
}
