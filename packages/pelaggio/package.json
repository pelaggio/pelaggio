{
	"name": "pelaggio",
	"version": "0.1.0",
	"description": "Extend how much one developer can ship: autonomous plan → implement → review → ship cycles with Claude Code, Codex, Grok, or OpenCode — worktree-isolated, budget-capped, PR-gated, fail-closed",
	"keywords": [
		"ai",
		"agent",
		"agents",
		"autonomous",
		"coding-agent",
		"agent-harness",
		"claude",
		"claude-code",
		"codex",
		"grok",
		"opencode",
		"orchestration",
		"code-review",
		"git-worktree",
		"pipeline",
		"automation",
		"cli"
	],
	"license": "AGPL-3.0-or-later",
	"author": "Chris Horne",
	"homepage": "https://github.com/pelaggio/pelaggio#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pelaggio/pelaggio.git",
		"directory": "packages/pelaggio"
	},
	"bugs": {
		"url": "https://github.com/pelaggio/pelaggio/issues"
	},
	"packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
	"type": "module",
	"engines": {
		"node": ">=20.6"
	},
	"bin": {
		"pelaggio": "./bin/pelaggio.js",
		"plg": "./bin/pelaggio.js"
	},
	"main": "./scripts/pelaggio/index.ts",
	"exports": {
		".": "./scripts/pelaggio/index.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"scripts/pelaggio.ts",
		"scripts/pelaggio/**",
		".claude/skills/**",
		".claude-templates/**",
		"bin/**",
		"LICENSE",
		"!scripts/pelaggio/__tests__/**",
		"!scripts/pelaggio/**/*.test.ts",
		"scripts/pelaggio/__tests__/fixtures/review-bench/**"
	],
	"scripts": {
		"pelaggio": "tsx scripts/pelaggio.ts",
		"check:publish": "tsx scripts/check-publish.ts",
		"check:skills": "tsx scripts/pelaggio/check-skills.ts",
		"typecheck": "pnpm -w exec tsc --noEmit --pretty false -p packages/pelaggio",
		"test": "tsx --test --test-timeout=60000 scripts/pelaggio/__tests__/*.test.ts",
		"prepack": "tsx scripts/pack-prepare.ts",
		"postpack": "tsx scripts/pack-cleanup.ts"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.220",
		"diff": "^9.0.0",
		"tsx": "^4.23.1",
		"ulid": "^3.0.2",
		"yaml": "^2.9.0"
	},
	"peerDependencies": {
		"@linear/sdk": ">=50"
	},
	"peerDependenciesMeta": {
		"@linear/sdk": {
			"optional": true
		}
	}
}
