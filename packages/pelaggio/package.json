{
	"name": "pelaggio",
	"version": "0.1.0",
	"description": "Headless pipeline for running Claude Agent SDK cycles per roadmap item",
	"license": "AGPL-3.0-or-later",
	"packageManager": "pnpm@10.32.1",
	"type": "module",
	"engines": {
		"node": ">=20.6"
	},
	"bin": {
		"pelaggio": "./bin/pelaggio.js",
		"plg": "./bin/pelaggio.js"
	},
	"main": "./scripts/pelaggio/index.ts",
	"exports": {
		".": "./scripts/pelaggio/index.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"scripts/pelaggio.ts",
		"scripts/pelaggio/**",
		".claude/skills/**",
		".claude-templates/**",
		"bin/**",
		"LICENSE",
		"!scripts/pelaggio/__tests__/**",
		"!scripts/pelaggio/**/*.test.ts"
	],
	"scripts": {
		"pelaggio": "tsx scripts/pelaggio.ts",
		"check:publish": "tsx scripts/check-publish.ts",
		"check:skills": "tsx scripts/pelaggio/check-skills.ts",
		"test": "tsx --test scripts/pelaggio/__tests__/*.test.ts",
		"prepack": "tsx scripts/pack-prepare.ts",
		"postpack": "tsx scripts/pack-cleanup.ts"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.177",
		"diff": "^9.0.0",
		"tsx": "^4.22.4",
		"yaml": "^2.9.0"
	},
	"peerDependencies": {
		"@linear/sdk": ">=50"
	},
	"peerDependenciesMeta": {
		"@linear/sdk": {
			"optional": true
		}
	}
}
