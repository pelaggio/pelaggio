+/**
+ * @param {{id: string, title: string, status: 'open' | 'done'}[]} items
+ * @returns {string}
+ */
+export function itemsToCsv(items) {
+  const quote = field => `"${String(field).replaceAll('"', '""')}"`;
+  return 'id,title,status\r\n' + items.map(item =>
+    [item.id, item.title, item.status].map(quote).join(',') + '\r\n'
+  ).join('');
+}
