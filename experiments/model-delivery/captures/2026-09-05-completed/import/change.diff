--- a/src/import.mjs
+++ b/src/import.mjs
@@ -1,14 +1,65 @@
 import { readFileSync } from 'node:fs';
 import { resolve } from 'node:path';
+import { isDeepStrictEqual } from 'node:util';
 import { readItems, writeItems } from './store.mjs';
-const source = process.argv[2];
-if (!source) throw new Error('Usage: node src/import.mjs <items.json>');
-const path = process.env.DEMO_STORE || resolve('data/items.json');
-const rows = JSON.parse(readFileSync(source, 'utf8'));
-for (const row of rows) {
-  const items = readItems(path);
-  items.push(row);
-  writeItems(path, items);
-  console.log(`committed ${row.id}`);
-  await new Promise(done => setTimeout(done, Number(process.env.DEMO_IMPORT_DELAY_MS || 0)));
+
+/** @typedef {{id: string, title: string, status: 'open' | 'done', [key: string]: unknown}} Item */
+
+/** @param {unknown} value @returns {Item[]} */
+function validate(value) {
+  if (!Array.isArray(value)) throw new Error('expected a JSON array');
+  for (const [index, row] of value.entries()) {
+    if (row === null || typeof row !== 'object' || Array.isArray(row) ||
+        typeof row.id !== 'string' || typeof row.title !== 'string' ||
+        (row.status !== 'open' && row.status !== 'done')) {
+      throw new Error(`invalid record at row ${index} (zero-based): expected string id/title and open/done status`);
+    }
+  }
+  return value;
+}
+
+/** @param {Item[]} rows @param {Item[]} items @returns {Item[]} */
+function pendingRows(rows, items) {
+  const byId = new Map();
+  for (const [index, item] of items.entries()) {
+    if (byId.has(item.id)) {
+      throw new Error(`store duplicate id ${JSON.stringify(item.id)} at row ${index}`);
+    }
+    byId.set(item.id, item);
+  }
+  const pending = [];
+  for (const [index, row] of rows.entries()) {
+    if (byId.has(row.id)) {
+      if (!isDeepStrictEqual(byId.get(row.id), row)) {
+        throw new Error(`source conflict for id ${JSON.stringify(row.id)} at row ${index}`);
+      }
+    } else {
+      pending.push(row);
+      byId.set(row.id, row);
+    }
+  }
+  return pending;
+}
+
+let context = 'import';
+try {
+  const source = process.argv[2];
+  if (!source) throw new Error('Usage: node src/import.mjs <items.json>');
+  const path = process.env.DEMO_STORE || resolve('data/items.json');
+  context = `source ${source}`;
+  const rows = validate(JSON.parse(readFileSync(source, 'utf8')));
+  context = `store ${path}`;
+  const items = validate(readItems(path));
+  context = 'import preflight';
+  const pending = pendingRows(rows, items);
+  for (const row of pending) {
+    context = `store ${path}, id ${JSON.stringify(row.id)}`;
+    items.push(row);
+    writeItems(path, items);
+    console.log(`committed ${row.id}`);
+    await new Promise(done => setTimeout(done, Number(process.env.DEMO_IMPORT_DELAY_MS || 0)));
+  }
+} catch (error) {
+  console.error(`${context}: ${error instanceof SyntaxError ? 'malformed JSON' : error.message}`);
+  process.exit(1);
 }
diff --git a/test/import.test.mjs b/test/import.test.mjs
new file mode 100644
index 0000000..04c85c4
--- /dev/null
+++ b/test/import.test.mjs
@@ -0,0 +1,250 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { mkdtempSync, mkdirSync, readFileSync, writeFileSync, existsSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { fixture } from '../src/store.mjs';
+
+const importer = fileURLToPath(new URL('../src/import.mjs', import.meta.url));
+const item = (id, extra = {}) => ({ id, title: `Title ${id}`, status: 'open', ...extra });
+const commits = stdout => stdout.split('\n').filter(line => line.startsWith('committed '))
+  .map(line => line.slice('committed '.length));
+
+function harness(t) {
+  const dir = mkdtempSync(join(tmpdir(), 'workbench-import-'));
+  const source = join(dir, 'rows.json');
+  const store = join(dir, 'nested', 'items.json');
+  const children = [];
+  const write = (path, value) => {
+    mkdirSync(dirname(path), { recursive: true });
+    writeFileSync(path, JSON.stringify(value));
+  };
+  t.after(async () => {
+    for (const run of children) if (run.child.exitCode === null) run.child.kill('SIGKILL');
+    await Promise.all(children.map(run => run.done));
+    rmSync(dir, { recursive: true, force: true });
+  });
+  function start({ delay = 0, args = [source] } = {}) {
+    const child = spawn(process.execPath, [importer, ...args], {
+      cwd: dir,
+      env: { ...process.env, DEMO_STORE: store, DEMO_IMPORT_DELAY_MS: String(delay) },
+      stdio: ['ignore', 'pipe', 'pipe'],
+    });
+    const run = { child, stdout: '', stderr: '', done: null };
+    child.stdout.setEncoding('utf8').on('data', data => { run.stdout += data; });
+    child.stderr.setEncoding('utf8').on('data', data => { run.stderr += data; });
+    run.done = new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        child.kill('SIGKILL');
+        reject(new Error('import deadline exceeded'));
+      }, 10000);
+      child.once('error', error => { clearTimeout(timer); reject(error); });
+      child.once('close', (code, signal) => {
+        clearTimeout(timer);
+        resolve({ code, signal, stdout: run.stdout, stderr: run.stderr });
+      });
+    });
+    children.push(run);
+    return run;
+  }
+  return { dir, source, store, write, start, read: () => JSON.parse(readFileSync(store, 'utf8')) };
+}
+
+function waitForCommits(run, count) {
+  return new Promise((resolve, reject) => {
+    const finish = error => {
+      clearTimeout(timer);
+      run.child.stdout.off('data', check);
+      run.child.off('close', closed);
+      error ? reject(error) : resolve();
+    };
+    const check = () => {
+      const completeLines = run.stdout.slice(0, run.stdout.lastIndexOf('\n') + 1);
+      if (commits(completeLines).length >= count) finish();
+    };
+    const closed = () => finish(new Error(`import exited before progress: ${run.stderr}`));
+    const timer = setTimeout(() => finish(new Error('progress deadline exceeded')), 5000);
+    run.child.stdout.on('data', check);
+    run.child.once('close', closed);
+    check();
+  });
+}
+
+for (const mode of ['seeded', 'stale scratch', 'missing store']) {
+  test(`SIGKILL and restart resumes exactly once: ${mode}`, async t => {
+    const h = harness(t);
+    const seed = mode === 'missing store' ? fixture : [item('keep', { metadata: [1, 2] })];
+    if (mode !== 'missing store') h.write(h.store, seed);
+    if (mode === 'stale scratch') writeFileSync(`${h.store}.tmp`, 'garbage');
+    const rows = Array.from({ length: 8 }, (_, i) => item(`new ${i}`));
+    h.write(h.source, rows);
+    const run = h.start({ delay: 150 });
+    await waitForCommits(run, 2);
+    assert.equal(run.child.kill('SIGKILL'), true);
+    assert.equal((await run.done).signal, 'SIGKILL');
+    const partial = h.read();
+    assert.deepEqual(partial.slice(0, seed.length), seed);
+    const imported = partial.slice(seed.length);
+    assert.ok(imported.length >= 2 && imported.length < rows.length);
+    assert.deepEqual(imported, rows.slice(0, imported.length));
+    assert.equal(new Set(partial.map(row => row.id)).size, partial.length);
+    // A leftover scratch file is never progress evidence, including after a kill.
+    if (mode === 'stale scratch') writeFileSync(`${h.store}.tmp`, 'incomplete JSON');
+    const resumed = await h.start().done;
+    assert.equal(resumed.code, 0, resumed.stderr);
+    assert.deepEqual(commits(resumed.stdout), rows.slice(imported.length).map(row => row.id));
+    assert.deepEqual(h.read(), [...seed, ...rows]);
+    const bytes = readFileSync(h.store);
+    const repeated = await h.start().done;
+    assert.equal(repeated.code, 0, repeated.stderr);
+    assert.deepEqual(commits(repeated.stdout), []);
+    assert.deepEqual(readFileSync(h.store), bytes);
+  });
+}
+
+test('complete structural equality skips existing rows and source duplicates', async t => {
+  const h = harness(t);
+  const existing = item('existing', { metadata: { a: 1, b: [null, { c: true }] } });
+  h.write(h.store, [existing]);
+  const reordered = { metadata: { b: [null, { c: true }], a: 1 }, status: 'open', title: existing.title, id: existing.id };
+  const added = item('', { title: '', metadata: { nested: ['kept'] } });
+  h.write(h.source, [reordered, added, added]);
+  const result = await h.start().done;
+  assert.equal(result.code, 0, result.stderr);
+  assert.deepEqual(commits(result.stdout), ['']);
+  assert.deepEqual(h.read(), [existing, added]);
+  const bytes = readFileSync(h.store);
+  const repeated = await h.start().done;
+  assert.equal(repeated.code, 0, repeated.stderr);
+  assert.equal(repeated.stdout, '');
+  assert.deepEqual(readFileSync(h.store), bytes);
+});
+
+for (const missing of [false, true]) {
+  test(`empty source is a byte-preserving no-op (missing store: ${missing})`, async t => {
+    const h = harness(t);
+    if (!missing) { h.write(h.store, [item('seed')]); writeFileSync(h.store, `\n${readFileSync(h.store)}\n`); }
+    const before = missing ? null : readFileSync(h.store);
+    h.write(h.source, []);
+    const result = await h.start().done;
+    assert.equal(result.code, 0, result.stderr);
+    assert.equal(result.stdout, '');
+    if (missing) assert.equal(existsSync(h.store), false);
+    else assert.deepEqual(readFileSync(h.store), before);
+  });
+  test(`nonempty source respects empty versus missing store (missing: ${missing})`, async t => {
+    const h = harness(t);
+    if (!missing) h.write(h.store, []);
+    const rows = [item('added')];
+    h.write(h.source, rows);
+    const result = await h.start().done;
+    assert.equal(result.code, 0, result.stderr);
+    assert.deepEqual(h.read(), [...(missing ? fixture : []), ...rows]);
+  });
+}
+
+for (const change of [{ title: 'changed' }, { status: 'done' }, { extra: 2 }]) {
+  for (const withinSource of [false, true]) {
+    test(`conflict preflight preserves bytes: ${JSON.stringify(change)}, source=${withinSource}`, async t => {
+      const h = harness(t);
+      const original = item('conflict id', { extra: 1 });
+      h.write(h.store, withinSource ? [item('seed')] : [original]);
+      const before = readFileSync(h.store);
+      h.write(h.source, [item('new'), ...(withinSource ? [original] : []), { ...original, ...change }]);
+      const result = await h.start().done;
+      assert.equal(result.code, 1);
+      assert.match(result.stderr, /source conflict.*conflict id.*row/);
+      assert.equal(result.stdout, '');
+      assert.deepEqual(readFileSync(h.store), before);
+    });
+  }
+}
+
+for (const unequal of [false, true]) {
+  test(`legacy duplicate store ids fail without repair (unequal: ${unequal})`, async t => {
+    const h = harness(t);
+    h.write(h.store, [item('duplicate'), item('duplicate', unequal ? { title: 'different' } : {})]);
+    const before = readFileSync(h.store);
+    h.write(h.source, [item('new')]);
+    const result = await h.start().done;
+    assert.equal(result.code, 1);
+    assert.match(result.stderr, /store duplicate id "duplicate"/);
+    assert.equal(result.stdout, '');
+    assert.deepEqual(readFileSync(h.store), before);
+  });
+}
+
+const invalidInputs = [
+  ['malformed JSON', '[{"private":"do not print this"}', /malformed JSON/],
+  ['empty file', '', /malformed JSON/],
+  ['whitespace only', ' \n\t', /malformed JSON/],
+  ...[null, {}, 'text', 5, true].map(value => ['non-array root', JSON.stringify(value), /expected a JSON array/]),
+  ...[null, [], {}, { id: 1, title: 't', status: 'open' },
+    { id: 'x', title: null, status: 'open' }, { id: 'x', title: 't' },
+    { title: 't', status: 'open' }, { id: 'x', status: 'open' },
+    { id: 'x', title: 't', status: 'pending' }]
+    .map(row => ['invalid row', JSON.stringify([item('valid prefix'), row]), /invalid record at row 1/]),
+];
+
+for (const missing of [false, true]) {
+  test(`invalid sources fail before any mutation (missing store: ${missing})`, async t => {
+    const h = harness(t);
+    if (!missing) h.write(h.store, [item('seed')]);
+    const before = missing ? null : readFileSync(h.store);
+    for (const [label, raw, diagnostic] of invalidInputs) {
+      writeFileSync(h.source, raw);
+      const result = await h.start().done;
+      assert.equal(result.code, 1, label);
+      assert.match(result.stderr, /^source /);
+      assert.match(result.stderr, diagnostic, label);
+      assert.doesNotMatch(result.stderr, /do not print this|\n\s+at /);
+      assert.equal(result.stdout, '');
+      if (missing) assert.equal(existsSync(h.store), false);
+      else assert.deepEqual(readFileSync(h.store), before);
+    }
+  });
+}
+
+test('malformed and invalid existing stores remain untouched', async t => {
+  const h = harness(t);
+  h.write(h.source, [item('new')]);
+  h.write(h.store, []);
+  for (const [label, raw, diagnostic] of invalidInputs) {
+    writeFileSync(h.store, raw);
+    const before = readFileSync(h.store);
+    const result = await h.start().done;
+    assert.equal(result.code, 1, label);
+    assert.match(result.stderr, /^store /);
+    assert.match(result.stderr, diagnostic, label);
+    assert.doesNotMatch(result.stderr, /do not print this|\n\s+at /);
+    assert.equal(result.stdout, '');
+    assert.deepEqual(readFileSync(h.store), before);
+  }
+});
+
+test('usage and missing source fail without creating a store', async t => {
+  const h = harness(t);
+  const usage = await h.start({ args: [] }).done;
+  assert.equal(usage.code, 1);
+  assert.match(usage.stderr, /Usage:/);
+  const missing = await h.start().done;
+  assert.equal(missing.code, 1);
+  assert.match(missing.stderr, /^source .+: .*ENOENT/);
+  assert.equal(usage.stdout + missing.stdout, '');
+  assert.equal(existsSync(h.store), false);
+});
+
+test('first-write failure preserves the store and never acknowledges a row', async t => {
+  const h = harness(t);
+  h.write(h.store, [item('seed')]);
+  const before = readFileSync(h.store);
+  h.write(h.source, [item('new')]);
+  mkdirSync(`${h.store}.tmp`);
+  const result = await h.start().done;
+  assert.equal(result.code, 1);
+  assert.match(result.stderr, /store.*id "new"/);
+  assert.equal(result.stdout, '');
+  assert.deepEqual(readFileSync(h.store), before);
+});
diff --git a/test/server.test.mjs b/test/server.test.mjs
new file mode 100644
index 0000000..c39e52a
--- /dev/null
+++ b/test/server.test.mjs
@@ -0,0 +1,97 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { mkdtempSync, writeFileSync, readFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { fixture } from '../src/store.mjs';
+
+test('imported store preserves HTTP listing, filters, pagination, and safe UI rendering', async t => {
+  const dir = mkdtempSync(join(tmpdir(), 'workbench-server-'));
+  const store = join(dir, 'nested', 'items.json');
+  const source = join(dir, 'source.json');
+  const children = [];
+  t.after(async () => {
+    for (const run of children) if (run.child.exitCode === null) run.child.kill('SIGKILL');
+    await Promise.all(children.map(run => run.done));
+    rmSync(dir, { recursive: true, force: true });
+  });
+  function start(module, args = []) {
+    const child = spawn(process.execPath, [fileURLToPath(new URL(module, import.meta.url)), ...args], {
+      cwd: dir,
+      env: { ...process.env, DEMO_STORE: store, DEMO_IMPORT_DELAY_MS: '0', PORT: '0' },
+      stdio: ['ignore', 'pipe', 'pipe'],
+    });
+    const run = { child, stdout: '', stderr: '', done: null };
+    child.stdout.setEncoding('utf8').on('data', data => { run.stdout += data; });
+    child.stderr.setEncoding('utf8').on('data', data => { run.stderr += data; });
+    run.done = new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        child.kill('SIGKILL');
+        reject(new Error(`${module} deadline exceeded`));
+      }, 15000);
+      child.once('error', error => { clearTimeout(timer); reject(error); });
+      child.once('close', code => { clearTimeout(timer); resolve(code); });
+    });
+    children.push(run);
+    return run;
+  }
+
+  const added = Array.from({ length: 15 }, (_, i) => ({
+    id: `HTTP ${i}`, title: i === 0 ? '<img src=x onerror=alert(1)>' : `Imported ${i}`,
+    status: i < 7 ? 'open' : 'done',
+  }));
+  writeFileSync(source, JSON.stringify(added));
+  const imported = start('../src/import.mjs', [source]);
+  assert.equal(await imported.done, 0, imported.stderr);
+  assert.deepEqual(imported.stdout.split('\n').filter(line => line.startsWith('committed '))
+    .map(line => line.slice('committed '.length)), added.map(row => row.id));
+  const expected = [...fixture, ...added];
+  assert.deepEqual(JSON.parse(readFileSync(store, 'utf8')), expected);
+
+  const server = start('../src/server.mjs');
+  const port = await new Promise((resolve, reject) => {
+    const finish = (error, value) => {
+      clearTimeout(timer);
+      server.child.stdout.off('data', check);
+      server.child.off('close', closed);
+      error ? reject(error) : resolve(value);
+    };
+    const check = () => {
+      const lines = server.stdout.slice(0, server.stdout.lastIndexOf('\n') + 1).split('\n');
+      const line = lines.find(value => value.startsWith('listening '));
+      if (line !== undefined) finish(null, Number(line.slice('listening '.length)));
+    };
+    const closed = () => finish(new Error(`server exited before listening: ${server.stderr}`));
+    const timer = setTimeout(() => finish(new Error('server startup deadline exceeded')), 5000);
+    server.child.stdout.on('data', check);
+    server.child.once('close', closed);
+    check();
+  });
+  assert.ok(Number.isInteger(port) && port > 0 && port <= 65535);
+  const base = `http://127.0.0.1:${port}`;
+  const home = await fetch(base, { signal: AbortSignal.timeout(5000) });
+  assert.equal(home.status, 200);
+  assert.match(home.headers.get('content-type'), /text\/html/);
+  const html = readFileSync(new URL('../public/index.html', import.meta.url), 'utf8');
+  assert.equal(await home.text(), html);
+  assert.match(html, /\.textContent\s*=/);
+
+  for (const status of ['', 'open', 'done']) {
+    const matching = expected.filter(row => !status || row.status === status);
+    for (const page of [1, 2, 3, 4, 5, 99]) {
+      const response = await fetch(`${base}/api/items?status=${status}&page=${page}`, {
+        signal: AbortSignal.timeout(5000),
+      });
+      assert.equal(response.status, 200);
+      assert.match(response.headers.get('content-type'), /application\/json/);
+      assert.deepEqual(await response.json(), {
+        items: matching.slice((page - 1) * 10, page * 10),
+        total: matching.length, page, pageSize: 10,
+      }, `status=${status}, page=${page}`);
+    }
+  }
+  const defaults = await fetch(`${base}/api/items`, { signal: AbortSignal.timeout(5000) });
+  assert.deepEqual(await defaults.json(), { items: fixture.slice(0, 10), total: 45, page: 1, pageSize: 10 });
+});
