{
	"name": "claude-autopilot-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "Workspace root for claude-autopilot — see packages/autopilot for the published pipeline.",
	"license": "UNLICENSED",
	"packageManager": "pnpm@10.32.1",
	"type": "module",
	"scripts": {
		"autopilot": "pnpm --filter @cdhorne/claude-autopilot autopilot",
		"test": "pnpm -r test",
		"check": "biome check",
		"check:skills": "pnpm --filter @cdhorne/claude-autopilot check:skills",
		"check:publish": "pnpm --filter @cdhorne/claude-autopilot check:publish",
		"format": "biome check --write",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@anthropic-ai/claude-code": "^2.1.119",
		"@biomejs/biome": "^2.4.13",
		"@cdhorne/claude-autopilot": "workspace:*",
		"lefthook": "^2.1.6",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3"
	}
}
