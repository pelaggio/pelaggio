    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.113",
    "@anthropic-ai/claude-code": "^2.1.113",
    "@biomejs/biome": "^2.4.12",
    "lefthook": "^1.13.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
