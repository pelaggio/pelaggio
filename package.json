{
	"name": "pelaggio-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "Workspace root for pelaggio — see packages/pelaggio for the published pipeline.",
	"license": "AGPL-3.0-or-later",
	"packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
	"type": "module",
	"scripts": {
		"pelaggio": "pnpm --filter pelaggio pelaggio",
		"test": "pnpm -r test",
		"test:ci": "bash ci/test-realization-mutation.sh && bash ci/test-assurance.test.sh && bash ci/test-assurance.sh",
		"typecheck": "pnpm --filter pelaggio typecheck && pnpm --filter @pelaggio/server typecheck && pnpm --filter @pelaggio/web check:types",
		"typecheck:ratchet": "node --import tsx ci/typecheck-ratchet.ts",
		"check": "biome check",
		"check:skills": "pnpm --filter pelaggio check:skills",
		"check:publish": "pnpm --filter pelaggio check:publish",
		"check:trust": "node --import tsx ci/verify-claims.ts",
		"check:links": "node --import tsx ci/verify-links.ts",
		"check:doc-claims": "node --import tsx ci/verify-doc-claims.ts",
		"trust:generate": "node --import tsx ci/trust-manifest.ts --write",
		"format": "biome check --write",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@anthropic-ai/claude-code": "^2.1.251",
		"@biomejs/biome": "^2.5.11",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"lefthook": "^2.1.12",
		"pelaggio": "workspace:*",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3"
	}
}
