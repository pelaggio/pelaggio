{
  "name": "claude-autopilot",
  "version": "0.1.0",
  "private": true,
  "description": "Headless pipeline for running Claude Agent SDK cycles per roadmap item",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "autopilot": "tsx scripts/autopilot.ts",
    "test": "tsx --test scripts/autopilot/__tests__/*.test.ts",
    "check": "biome check scripts/",
