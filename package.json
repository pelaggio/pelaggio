{
	"name": "pelaggio-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "Workspace root for pelaggio — see packages/pelaggio for the published pipeline.",
	"license": "FSL-1.1-ALv2",
	"packageManager": "pnpm@10.32.1",
	"type": "module",
	"scripts": {
		"pelaggio": "pnpm --filter pelaggio pelaggio",
		"test": "pnpm -r test",
		"test:ci": "node --import tsx --test --test-reporter=dot ci/__tests__/*.test.ts",
		"check": "biome check",
		"check:skills": "pnpm --filter pelaggio check:skills",
		"check:publish": "pnpm --filter pelaggio check:publish",
		"check:trust": "node --import tsx ci/verify-claims.ts",
		"trust:generate": "node --import tsx ci/trust-manifest.ts --write",
		"format": "biome check --write",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@anthropic-ai/claude-code": "^2.1.177",
		"@biomejs/biome": "^2.5.0",
		"pelaggio": "workspace:*",
		"lefthook": "^2.1.9",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	}
}
